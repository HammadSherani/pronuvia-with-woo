generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_REP
  PHYSICIAN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BankAccountType {
  CHECKING
  SAVINGS
}

enum BankOwnershipType {
  PERSONAL
  BUSINESS
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesRepresentative {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  firstName         String
  lastName          String
  email             String   @unique
  loginId           String?  @unique
  website           String?
  password          String
  phone             String?
  ordersCount       Int      @default(0)
  commission        Float    @default(0)
  walletBalance     Float    @default(0)
  billingAddress    String?
  shippingAddress   String?
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  bankAccountType       BankAccountType?
  bankOwnershipType     BankOwnershipType?
  swiftCode             String?
  routingNumber         String?
  bankNotifyRequested   Boolean  @default(false)
  // Linked WooCommerce customer (set by lib/woo/customers.ts). Not @unique:
  // MongoDB unique indexes treat every missing value as a duplicate.
  wooCustomerId         Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  passwordResetToken  String?
  passwordResetExpiry DateTime?

  physicians  PartneringPhysician[]
  orderItems  Order[]
}

model PartneringPhysician {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  isApproved          ApprovalStatus @default(PENDING)
  firstName           String
  lastName            String
  email               String         @unique
  loginId             String?        @unique
  password            String
  // True when the physician (or whoever created the account on their behalf)
  // explicitly set this password at creation, rather than it being an
  // unknown placeholder — drives the welcome email's dynamic Login Info
  // password line. Always true for accounts created after this field
  // shipped; false/missing for older records.
  hasCustomPassword   Boolean        @default(false)
  aictherapy          String?
  license             String?
  websiteLink         String?
  addressOne          String?
  addressTwo          String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  phone               String?
  officeContactNumber String?
  fax                 String?
  nameOfPractice      String?
  yearsInPractice     Int?
  credential          String?
  patientsPerMonth    Int?
  fieldsOfSpeciality  String[]
  commission          Float          @default(0)
  uplineCommission    Float          @default(0)
  salesRepNote        String?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  bankName              String?
  bankAccountNumber     String?
  bankAccountName       String?
  bankAccountType       BankAccountType?
  bankOwnershipType     BankOwnershipType?
  swiftCode             String?
  routingNumber         String?
  bankNotifyRequested   Boolean        @default(false)
  walletBalance         Float          @default(0)
  // Linked WooCommerce customer, created once the physician is APPROVED
  wooCustomerId         Int?
  ordersCount         Int            @default(0)
  addedByRole         Role
  addedByAdminId      String?        @db.ObjectId
  salesRepId          String?        @db.ObjectId
  salesRep            SalesRepresentative? @relation(fields: [salesRepId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  orderItems  Order[]
}

model CatalogDocument {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName   String
  fileUrl    String
  fileSize   Int
  uploadedBy String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Admin review of an order's commission (WP order page, Pronuvia
// Commissions plugin). Missing = approved: orders from before reviews.
enum CommissionReview {
  AWAITING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

model Order {
  id                        String               @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber               String               @unique

  physicianId               String?              @db.ObjectId
  physician                 PartneringPhysician? @relation(fields: [physicianId], references: [id])

  salesRepId                String?              @db.ObjectId
  salesRep                  SalesRepresentative? @relation(fields: [salesRepId], references: [id])

  items                     Json[]

  subtotal                  Float
  total                     Float

  // Rates snapshotted at order creation — never recalculated on rate changes
  salesRepCommissionRate    Float                @default(0)
  salesRepCommissionAmount  Float                @default(0)
  physicianCommissionRate   Float                @default(0)
  physicianCommissionAmount Float                @default(0)

  status                    OrderStatus          @default(PENDING)
  commissionPaid            Boolean              @default(false)
  billingAddress            String?
  shippingAddress           String?
  shippingRate              Float                @default(0)
  // The shipping option the customer selected at checkout (e.g. "Shipping
  // United States Flat Rate" or "FedEx 2Day Shipping") — distinct from
  // shippingCarrier, which only gets set once an admin actually buys a
  // label. Lets the admin know to buy an expedited label for this order.
  shippingMethod            String?
  shippingCarrier           String?
  trackingNumber            String?
  estimatedDelivery         DateTime?
  paymentMethod             String?
  paymentStatus             String?
  transactionId             String?
  stripePaymentIntentId     String?
  notes                     String?

  couponCode                String?
  couponId                  String?              @db.ObjectId
  discountAmount            Float                @default(0)
  // Tax WooCommerce charged (items + shipping); null on orders before Phase 5
  taxAmount                 Float?

  // The WooCommerce order this order was sent to (Phase 6). Orders are saved
  // here first (with any wallet debit), then created in Woo:
  // PENDING_SYNC → SYNCING → SYNCED. A failed send goes back to PENDING_SYNC
  // and is retried by /api/cron/woo-order-sync. Null on orders before Phase 6.
  wooOrderId                Int?
  wooSyncStatus             String?
  wooSyncError              String?
  wooSyncAttempts           Int?
  wooSyncAt                 DateTime?
  // Woo rate id of the shipping option, e.g. "flat_rate:9"
  shippingRateId            String?

  customerEmail             String?
  customerPhone             String?

  placedByAdmin             Boolean              @default(false)
  placedBySalesRep          Boolean              @default(false)

  // Return / clawback fields
  returnedAt                DateTime?
  returnReason              String?
  returnedItems             Json?                // null = full return, array of item indexes = partial
  returnedTotal             Float?               // $ value of returned items
  salesRepClawback          Float?               // deducted from sales rep wallet
  physicianClawback         Float?               // informational — physician has no wallet
  // Commission review per role (null = approved). Modify keeps the first
  // amount in *CommissionOriginal and sets *CommissionAmount to the new one.
  physicianCommissionReview   CommissionReview?
  salesRepCommissionReview    CommissionReview?
  physicianCommissionOriginal Float?
  salesRepCommissionOriginal  Float?
  commissionReviewNotes       Json?    // { physician?: {note, at, by}, salesRep?: {...} }
  // When the reviewed commission went into the wallets (Commission Payout).
  // Until the user's payout is approved it can still be changed on WP; the
  // approval sets *PaidOutAt for that role, and from then on only "Refund
  // commission" applies.
  commissionCreditedAt         DateTime?
  physicianCommissionPaidOutAt DateTime?
  salesRepCommissionPaidOutAt  DateTime?

  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
}

model OrderRefund {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String   @db.ObjectId
  refundNumber      Int
  items             Json?    // Array<{index, returnedQty, lineTotal}>; null = legacy full-refund marker
  total             Float
  salesRepClawback  Float    @default(0)
  physicianClawback Float    @default(0)
  reason               String?
  customerRefundMethod String?  // "manual" | "stripe" | "wallet"
  customerRefundAmount Float?
  stripeRefundId       String?
  // Why the card refund for a WP admin refund did not go through yet (the
  // cron tries again); null once Stripe took it
  stripeRefundError    String?
  // The matching WooCommerce refund (Phase 9). Refunds made here create it;
  // refunds made in WP admin are imported with it (one record per Woo refund).
  wooRefundId          Int?
  source               String?  // "pronuvia" | "woocommerce"; null before Phase 9
  processedAt          DateTime @default(now())
}

// The server-side price of a card checkout, saved when its Stripe
// PaymentIntent is created (the PaymentIntent's amount is this total). The
// order is built from this once the payment succeeds, never from the browser.
model CheckoutQuote {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   // who is paying: the rep, the physician, or the admin ordering on behalf
  physicianId String?  // admin "order on behalf": the physician the order is for
  order       Json     // PricedOrder from lib/checkout/price-order.ts
  total       Float
  createdAt   DateTime @default(now())
}

// A shipping label bought with the WooCommerce Shipping plugin (WP admin),
// read from the Woo order's `wcshipping_labels` meta. Kept here so each
// label's tracking email goes out once and the order lists show tracking.
// Labels bought with the old custom FedEx / UPS / USPS code stay in Shipment.
model WooLabel {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  orderId     String    @db.ObjectId
  labelId     Int                       // the plugin's label id
  tracking    String
  carrier     String                    // usps, ups, fedex, dhlexpress
  service     String
  packageName String?
  isReturn    Boolean   @default(false)
  refunded    Boolean   @default(false)
  purchasedAt DateTime
  notifiedAt  DateTime?                 // tracking email sent
  createdAt   DateTime  @default(now())

  @@unique([orderId, labelId])
}

model Shipment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String   @db.ObjectId
  carrier        String
  carrierLabel   String
  service        String
  serviceCode    String
  trackingNumber String
  labelBase64    String?
  labelFormat    String   @default("PNG")
  // Physical label page size requested from the carrier: "4X6" (thermal
  // printer) or "LETTER" (8.5x11, normal paper printer).
  labelSize      String   @default("4X6")
  // True for a return shipping label (customer -> warehouse), false for a
  // normal outbound label (warehouse -> customer).
  isReturn       Boolean  @default(false)
  fromAddress    Json
  toAddress      Json
  weightLbs      Float
  lengthIn       Float?
  widthIn        Float?
  heightIn       Float?
  cost           Float    @default(0)
  currency       String   @default("USD")
  status         String   @default("created")
  shipDate       DateTime @default(now())
  createdAt      DateTime @default(now())
}

// Sequences that must never hand out a number twice (an order number can
// otherwise come back after the newest order is deleted).
model Counter {
  id    String @id @map("_id")   // e.g. "orderNumber"
  value Int
}

// Commission taken back by the admin on the WP order page (Commissions box,
// "Refund commission") after it was approved and paid into the wallet.
// `key` is the refund's id from WP, so a repeated webhook applies it once.
model CommissionRefund {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  orderId   String   @db.ObjectId
  userId    String   @db.ObjectId
  userRole  Role
  amount    Float
  note      String?
  by        String?
  createdAt DateTime @default(now())
}

// The history of one order's commission per role, shown on the order pages:
// each review on the WP order page (approved / rejected / modified), going
// into Commission Payout, the payout, and commission refunds.
model CommissionEvent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  key            String   @unique     // one row per WP history entry / payout / refund
  orderId        String   @db.ObjectId
  userRole       Role                 // PHYSICIAN or SALES_REP
  action         String               // APPROVED | REJECTED | PENDING | MODIFIED | IN_PAYOUT | PAID_OUT | REFUNDED
  amount         Float                // the commission after this event
  previousAmount Float?               // set when the amount changed
  walletChange   Float?               // money into (+) or out of (−) the wallet
  note           String?
  by             String?              // the WP admin; shown to admins only
  createdAt      DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  type      String   // "private" | "customer"
  content   String
  createdAt DateTime @default(now())
}

model WalletTransaction {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  userRole    Role
  amount      Float
  type        String
  description String?
  orderId     String?  @db.ObjectId
  // Commission period ("YYYY-MM", in PAYOUT_TIMEZONE) this transaction is
  // attributed to. Set on period-close commission credits and on any
  // reversal (the period the reversal happened in, not the order's period).
  periodKey   String?
  balance     Float
  createdAt   DateTime @default(now())
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model WithdrawRequest {
  id                       String                   @id @default(auto()) @map("_id") @db.ObjectId
  userId                   String                   @db.ObjectId
  userRole                 Role
  amount                   Float
  status                   WithdrawStatus          @default(PENDING)
  note                     String?
  adminNote                String?
  periodKey                String?
  snapshotAt               DateTime?
  notificationStatus       PayoutNotificationStatus @default(PENDING)
  notificationAttempts     Int                      @default(0)
  notificationLastAttemptAt DateTime?
  notificationLastError    String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

model Banner {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  imageUrl    String
  linkUrl     String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Blog {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  excerpt     String?
  content     String?
  imageUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WebsiteBanner {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String?
  buttonText  String?
  imageUrl    String
  linkUrl     String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ShippingMethod {
  FLAT
  FREE
  LOCAL_PICKUP
  FEDEX_2DAY
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
  BOUNCED
}

model EmailLog {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  recipientEmail  String
  subject         String
  // Human-readable category, e.g. "Order Confirmation", "Welcome Email",
  // "Password Reset" — null when the send site didn't classify itself.
  type            String?
  // Free-form pointer back to the record this email is about, e.g. an
  // order number or a user id — null when not applicable.
  relatedId       String?
  status          EmailLogStatus @default(QUEUED)
  // "sendgrid" | "smtp" — which transport ultimately handled (or attempted) the send.
  provider        String?
  errorMessage    String?
  responsePayload Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
